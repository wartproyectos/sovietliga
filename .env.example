# Copia este fichero a .env.local y rellena los valores del proyecto Supabase.
# .env.local está ignorado por git (patrón *.local en .gitignore).
#
# Ambas variables son públicas por diseño: acaban embebidas en el bundle del
# navegador. Lo que protege los datos es RLS, no el secreto de la clave.
# La clave `sb_secret_...` NUNCA debe aparecer aquí ni en el frontend.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
